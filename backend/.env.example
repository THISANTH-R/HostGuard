# ============================================================
# Host Security Monitoring Platform - Environment Configuration
# ============================================================
# Copy this file to .env and edit values as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
DATABASE_PATH=backend/database.db

# --- CORS ---
CORS_ORIGINS=*

# --- Collection Intervals (seconds) ---
RESOURCE_COLLECT_INTERVAL=5
SYSTEM_INFO_REFRESH_INTERVAL=300
NETWORK_COLLECT_INTERVAL=3
FIREWALL_COLLECT_INTERVAL=10

# --- Detection ---
YARA_RULES_DIR=backend/detections/yara_rules
IOC_FILE=backend/detections/iocs.json

# --- Startup ---
APP_NAME=HostSecurityMonitor
STARTUP_ENABLED=false
