# ==============================================================================
# HostGuard — Windows Host Security Monitoring Platform
# Environment Configuration
# ==============================================================================
# Copy this file to .env and modify values as needed.
# Default values are suitable for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=backend/database.db
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ------------------------------------------------------------------------------
# YARA Configuration
# ------------------------------------------------------------------------------
YARA_RULES_PATH=rules/yara/
# Set to false to disable YARA scanning at startup
YARA_ENABLED=true
# Maximum file size to scan (bytes). Files larger than this are skipped.
YARA_MAX_FILE_SIZE=52428800

# ------------------------------------------------------------------------------
# Collection Intervals (seconds)
# ------------------------------------------------------------------------------
# How frequently each collector polls for new data.
# Lower values = more responsive but higher CPU usage.
WINLOG_POLL_INTERVAL=2
SYSMON_POLL_INTERVAL=2
FIREWALL_POLL_INTERVAL=5
NETWORK_POLL_INTERVAL=5
RESOURCE_POLL_INTERVAL=5

# ------------------------------------------------------------------------------
# Correlation Engine
# ------------------------------------------------------------------------------
# Time window (seconds) for grouping related events into correlation clusters.
CORRELATION_WINDOW_SECONDS=60
# Minimum number of related events to form a correlation group.
CORRELATION_MIN_EVENTS=2

# ------------------------------------------------------------------------------
# Data Retention
# ------------------------------------------------------------------------------
# Maximum age of events before automatic cleanup (hours). 0 = no cleanup.
EVENT_RETENTION_HOURS=168
# Maximum database size in MB before oldest events are pruned. 0 = unlimited.
MAX_DATABASE_SIZE_MB=0

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
